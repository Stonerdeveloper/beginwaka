{
  "version": 2,
  "name": "beginwaka-consultation-booking",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next",
      "config": {
        "localCommand": "pnpm install --no-optional"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/"
    }
  ]
}